rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Julius Economias — backup cifrado por usuário
    match /backups/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Synth Wave Block Rush — ranking all-time por modo
    match /leaderboards/{mode}/entries/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && _validLeaderboardEntry(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && _validLeaderboardEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score;

      allow delete: if false;
    }

    function _validLeaderboardEntry(data) {
      return data.keys().hasOnly(['displayName', 'score', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 24
        && data.score is int
        && data.score >= 0
        && data.updatedAt is timestamp;
    }
  }
}
