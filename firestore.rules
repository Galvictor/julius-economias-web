rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Julius Economias — backup cifrado por usuário
    match /backups/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Synth Wave Block Rush — nicknames únicos (playerId = device hash)
    match /leaderboard_nicks/{nickKey} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && _validNickClaim(request.resource.data)
        && request.resource.data.keys().hasOnly([
             'displayName', 'playerId', 'updatedAt'
           ]);

      allow update: if request.auth != null
        && resource.data.playerId == request.resource.data.playerId
        && _validNickClaim(request.resource.data)
        && request.resource.data.keys().hasOnly([
             'displayName', 'playerId', 'updatedAt'
           ]);

      // Libera nick ao trocar. Claims `legacy: true` só via Admin / script.
      allow delete: if request.auth != null
        && resource.data.playerId is string
        && resource.data.playerId.size() >= 16
        && !(_isLegacyNick(resource.data));
    }

    // Synth Wave Block Rush — ranking all-time por modo (doc id = playerId)
    match /leaderboards/{mode}/entries/{playerId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && mode in ['classic', 'blitz', 'tetris']
        && request.resource.data.playerId == playerId
        && _validLeaderboardEntry(request.resource.data)
        && _nickOwnedByPlayer(
             request.resource.data.displayNameKey,
             playerId
           );

      allow update: if request.auth != null
        && mode in ['classic', 'blitz', 'tetris']
        && resource.data.playerId == playerId
        && request.resource.data.playerId == playerId
        && _validLeaderboardEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score
        && _nickOwnedByPlayer(
             request.resource.data.displayNameKey,
             playerId
           );

      allow delete: if false;
    }

    // Synth Wave Block Rush — resumo de partidas (stats)
    match /matches/{matchId} {
      allow read: if false;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && _validMatchSummary(request.resource.data);

      allow update, delete: if false;
    }

    function _isLegacyNick(data) {
      return 'legacy' in data && data.legacy == true;
    }

    function _validNickClaim(data) {
      return data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 24
        && data.playerId is string
        && data.playerId.size() >= 16
        && data.playerId.size() <= 128
        && data.updatedAt is timestamp;
    }

    function _nickOwnedByPlayer(displayNameKey, playerId) {
      return displayNameKey is string
        && displayNameKey.size() > 0
        && displayNameKey.size() <= 24
        && exists(/databases/$(database)/documents/leaderboard_nicks/$(displayNameKey))
        && get(/databases/$(database)/documents/leaderboard_nicks/$(displayNameKey))
              .data.playerId == playerId;
    }

    function _validLeaderboardEntry(data) {
      return data.keys().hasOnly([
          'displayName', 'displayNameKey', 'score', 'updatedAt', 'playerId'
        ])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 24
        && data.displayNameKey is string
        && data.displayNameKey.size() > 0
        && data.displayNameKey.size() <= 24
        && data.playerId is string
        && data.playerId.size() >= 16
        && data.playerId.size() <= 128
        && data.score is int
        && data.score >= 0
        && data.updatedAt is timestamp;
    }

    function _validMatchSummary(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'mode', 'gameOver', 'score',
          'totalMoves', 'maxCombo', 'perfectCount', 'linesCleared',
          'durationMs', 'appVersion', 'endedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'mode', 'gameOver', 'score',
          'totalMoves', 'maxCombo', 'perfectCount', 'linesCleared',
          'durationMs', 'appVersion', 'endedAt', 'level'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 24
        && data.mode is string
        && data.mode in ['classic', 'blitz', 'tetris']
        && data.gameOver is bool
        && data.score is int
        && data.score >= 0
        && data.totalMoves is int
        && data.totalMoves >= 0
        && data.maxCombo is int
        && data.maxCombo >= 0
        && data.perfectCount is int
        && data.perfectCount >= 0
        && data.linesCleared is int
        && data.linesCleared >= 0
        && data.durationMs is int
        && data.durationMs >= 0
        && data.appVersion is string
        && data.appVersion.size() > 0
        && data.appVersion.size() <= 32
        && data.endedAt is timestamp
        && (!('level' in data) || (data.level is int && data.level >= 1));
    }
  }
}
