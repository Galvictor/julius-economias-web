rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Julius Economias — backup cifrado por usuário
    match /backups/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Synth Wave Block Rush — meta do jogador (limite de renomes)
    match /players/{playerId} {
      allow read: if request.auth != null
        && resource.data.playerId == playerId;

      allow create: if request.auth != null
        && request.resource.data.playerId == playerId
        && playerId.size() >= 16
        && playerId.size() <= 128
        && _validPlayerMeta(request.resource.data)
        && request.resource.data.renameCount == 0;

      allow update: if request.auth != null
        && resource.data.playerId == playerId
        && request.resource.data.playerId == playerId
        && _validPlayerMeta(request.resource.data)
        && request.resource.data.renameCount >= resource.data.renameCount
        && request.resource.data.renameCount <= resource.data.renameCount + 1
        && request.resource.data.renameCount <= 3;

      allow delete: if false;
    }

    // Synth Wave Block Rush — nicknames únicos (playerId = device hash)
    match /leaderboard_nicks/{nickKey} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && _validNickClaim(request.resource.data)
        && nickKey == _normalizeNickKey(request.resource.data.displayName)
        && request.resource.data.keys().hasOnly([
             'displayName', 'playerId', 'updatedAt'
           ]);

      // Dono atualiza o próprio claim, OU qualquer auth reclaims claim legacy
      // (migração UID anônimo → deviceId; remove o campo legacy no write).
      allow update: if request.auth != null
        && _validNickClaim(request.resource.data)
        && nickKey == _normalizeNickKey(request.resource.data.displayName)
        && request.resource.data.keys().hasOnly([
             'displayName', 'playerId', 'updatedAt'
           ])
        && (
          resource.data.playerId == request.resource.data.playerId
          || _isLegacyNick(resource.data)
        );

      allow delete: if request.auth != null
        && resource.data.playerId is string
        && resource.data.playerId.size() >= 16
        && !(_isLegacyNick(resource.data));
    }

    // Synth Wave Block Rush — ranking all-time por modo (doc id = playerId)
    match /leaderboards/{mode}/entries/{playerId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && mode in ['classic', 'blitz', 'tetris']
        && request.resource.data.playerId == playerId
        && _validLeaderboardEntry(request.resource.data)
        && _nickOwnedByPlayer(
             request.resource.data.displayNameKey,
             playerId
           );

      allow update: if request.auth != null
        && mode in ['classic', 'blitz', 'tetris']
        && _validLeaderboardEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score
        && (
          // Entry moderno (tem playerId)
          (
            'playerId' in resource.data
            && resource.data.playerId == playerId
            && request.resource.data.playerId == playerId
            && _nickOwnedByPlayer(
                 request.resource.data.displayNameKey,
                 playerId
               )
          )
          // Entry legado (só displayName/score/updatedAt): dono do nick pode
          // sobrescrever ao migrar para o formato novo no mesmo doc id.
          || (
            !('playerId' in resource.data)
            && request.resource.data.playerId == playerId
            && _nickOwnedByPlayer(
                 request.resource.data.displayNameKey,
                 playerId
               )
          )
        );

      // Apaga entries legados (sem playerId) após migrar score para o deviceId.
      allow delete: if request.auth != null
        && !('playerId' in resource.data);
    }

    // Synth Wave Block Rush — resumo de partidas (stats)
    match /matches/{matchId} {
      allow read: if false;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && _validMatchSummary(request.resource.data);

      allow update, delete: if false;
    }

    function _isLegacyNick(data) {
      return 'legacy' in data && data.legacy == true;
    }

    function _normalizeNickKey(displayName) {
      return displayName.lower();
    }

    function _validDisplayNameShape(name) {
      return name is string
        && name.size() >= 3
        && name.size() <= 16
        && name.matches('^[A-Za-z0-9#_-]+( [A-Za-z0-9#_-]+){0,2}$')
        && !name.lower().matches('.*http.*')
        && !name.lower().matches('.*www.*')
        && !name.lower().matches('.*\\.com.*')
        && !name.lower().matches('.*\\.gg.*')
        && !name.lower().matches('.*\\.io.*')
        && !name.lower().matches('.*discord.*')
        && !name.lower().matches('.*telegram.*');
    }

    function _isReservedNickKey(key) {
      return key in [
        'admin', 'administrator', 'moderator', 'mod', 'developer', 'dev',
        'google', 'firebase', 'synthwave', 'synth wave', 'official',
        'suporte', 'support', 'sistema', 'system'
      ];
    }

    function _validNickClaim(data) {
      return _validDisplayNameShape(data.displayName)
        && !_isReservedNickKey(_normalizeNickKey(data.displayName))
        && data.playerId is string
        && data.playerId.size() >= 16
        && data.playerId.size() <= 128
        && data.updatedAt is timestamp;
    }

    function _validPlayerMeta(data) {
      return data.keys().hasOnly([
          'displayName', 'displayNameKey', 'playerId', 'renameCount', 'updatedAt'
        ])
        && _validDisplayNameShape(data.displayName)
        && !_isReservedNickKey(_normalizeNickKey(data.displayName))
        && data.displayNameKey is string
        && data.displayNameKey == _normalizeNickKey(data.displayName)
        && data.playerId is string
        && data.playerId.size() >= 16
        && data.playerId.size() <= 128
        && data.renameCount is int
        && data.renameCount >= 0
        && data.renameCount <= 3
        && data.updatedAt is timestamp;
    }

    function _nickOwnedByPlayer(displayNameKey, playerId) {
      return displayNameKey is string
        && displayNameKey.size() >= 3
        && displayNameKey.size() <= 16
        && exists(/databases/$(database)/documents/leaderboard_nicks/$(displayNameKey))
        && get(/databases/$(database)/documents/leaderboard_nicks/$(displayNameKey))
              .data.playerId == playerId;
    }

    function _validLeaderboardEntry(data) {
      return data.keys().hasOnly([
          'displayName', 'displayNameKey', 'score', 'updatedAt', 'playerId'
        ])
        && _validDisplayNameShape(data.displayName)
        && data.displayNameKey is string
        && data.displayNameKey == _normalizeNickKey(data.displayName)
        && data.playerId is string
        && data.playerId.size() >= 16
        && data.playerId.size() <= 128
        && data.score is int
        && data.score >= 0
        && data.updatedAt is timestamp;
    }

    function _validMatchSummary(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'mode', 'gameOver', 'score',
          'totalMoves', 'maxCombo', 'perfectCount', 'linesCleared',
          'durationMs', 'appVersion', 'endedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'mode', 'gameOver', 'score',
          'totalMoves', 'maxCombo', 'perfectCount', 'linesCleared',
          'durationMs', 'appVersion', 'endedAt', 'level'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && _validDisplayNameShape(data.displayName)
        && data.mode is string
        && data.mode in ['classic', 'blitz', 'tetris']
        && data.gameOver is bool
        && data.score is int
        && data.score >= 0
        && data.totalMoves is int
        && data.totalMoves >= 0
        && data.maxCombo is int
        && data.maxCombo >= 0
        && data.perfectCount is int
        && data.perfectCount >= 0
        && data.linesCleared is int
        && data.linesCleared >= 0
        && data.durationMs is int
        && data.durationMs >= 0
        && data.appVersion is string
        && data.appVersion.size() > 0
        && data.appVersion.size() <= 32
        && data.endedAt is timestamp
        && (!('level' in data) || (data.level is int && data.level >= 1));
    }
  }
}
