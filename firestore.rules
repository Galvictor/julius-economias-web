rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Julius Economias — backup cifrado por usuário
    match /backups/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Synth Wave Block Rush — ranking all-time por modo
    match /leaderboards/{mode}/entries/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && _validLeaderboardEntry(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && _validLeaderboardEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score;

      allow delete: if false;
    }

    // Synth Wave Block Rush — resumo de partidas (stats)
    match /matches/{matchId} {
      allow read: if false;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && _validMatchSummary(request.resource.data);

      allow update, delete: if false;
    }

    function _validLeaderboardEntry(data) {
      return data.keys().hasOnly(['displayName', 'score', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 24
        && data.score is int
        && data.score >= 0
        && data.updatedAt is timestamp;
    }

    function _validMatchSummary(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'mode', 'gameOver', 'score',
          'totalMoves', 'maxCombo', 'perfectCount', 'linesCleared',
          'durationMs', 'appVersion', 'endedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'mode', 'gameOver', 'score',
          'totalMoves', 'maxCombo', 'perfectCount', 'linesCleared',
          'durationMs', 'appVersion', 'endedAt', 'level'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 24
        && data.mode is string
        && data.mode in ['classic', 'blitz', 'tetris']
        && data.gameOver is bool
        && data.score is int
        && data.score >= 0
        && data.totalMoves is int
        && data.totalMoves >= 0
        && data.maxCombo is int
        && data.maxCombo >= 0
        && data.perfectCount is int
        && data.perfectCount >= 0
        && data.linesCleared is int
        && data.linesCleared >= 0
        && data.durationMs is int
        && data.durationMs >= 0
        && data.appVersion is string
        && data.appVersion.size() > 0
        && data.appVersion.size() <= 32
        && data.endedAt is timestamp
        && (!('level' in data) || (data.level is int && data.level >= 1));
    }
  }
}
